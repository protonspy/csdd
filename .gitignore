# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Compiled csdd binary + generated guide at the repo root only.
# Anchored with a leading slash so they do NOT match the npm/csdd/ package dir.
/csdd
/csdd.md

# Web dashboard. Neither node_modules nor the built bundle is committed — CI and
# the release pipeline run `make web-build` to produce internal/web/dist before
# `go build`. The committed dist/.gitkeep keeps //go:embed compiling for source
# builds (which then serve a "run make web-build" placeholder).
internal/web/frontend/node_modules/
internal/web/dist/*
!internal/web/dist/.gitkeep
# Root-anchored so it ignores the top-level `make dist` staging dir WITHOUT
# shadowing internal/web/dist (an unanchored `dist/` re-excludes the .gitkeep
# above, which breaks //go:embed all:dist on a clean checkout).
/dist/

# csdd
/.pinggy-token
/.claude/
/CLAUDE.md
/.mcp.json
/.githooks/
/specs/

# csdd operational state (.csdd/): local, regenerable — but commit manifests.
/.csdd/state.json
/.csdd/cache/
/.csdd/bot.json
# The plan runner's per-run state: ledger, failure logs, and the session-cost
# records. Per-run and machine-local — `csdd plan run` regenerates it. The code
# already documents this dir as transient and gitignored; this makes that true.
/.csdd/plan/
