// csdd sandbox — devcontainer definition (JSONC; comments are allowed).
// Open with your IDE's "Reopen in Container", or `devcontainer up`. Inside,
// bypass-mode Claude is safe: `csdd sandbox doctor` proves the isolation, so
// running with --dangerously-skip-permissions is a decision you can check
// rather than one you have to trust.
{
  "name": "csdd-sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    // HARDENED=true limits the vscode user's sudo to the firewall script only.
    "args": { "HARDENED": "{{.Hardened}}" }
  },
  // NET_ADMIN/NET_RAW let init-firewall.sh program iptables/ipset at start.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {}{{.ExtraFeatures}}
  },
  // Install Claude Code + the csdd CLI (the Node feature provides the runtime).
  // csdd ships as an npm package wrapping the Go binary, so `csdd …` is on PATH
  // without `npx`. Runs at create, before the firewall, while egress is open.
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code @protonspy/csdd",
  // Bring up the default-deny egress firewall on every start; it self-verifies
  // and exits non-zero if isolation is not enforced.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh"
}
