#!/usr/bin/env bash
# PreToolUse(Bash) hook: block obviously destructive commands.
# Claude Code passes the tool call as JSON on stdin; we read tool_input.command.
# Exit 2 blocks the call and feeds stderr back to the agent. Exit 0 allows it.
set -euo pipefail

input="$(cat)"

# Extract the command field. Prefer jq; fall back to python3; then a crude grep.
cmd=""
if command -v jq >/dev/null 2>&1; then
  cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty')"
elif command -v python3 >/dev/null 2>&1; then
  cmd="$(printf '%s' "$input" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("tool_input",{}).get("command",""))' 2>/dev/null || true)"
else
  cmd="$input"
fi

# Denylist of destructive patterns. Conservative on purpose: these need a human.
deny=(
  'rm[[:space:]]+-rf?[[:space:]]+/'      # rm -rf / ...
  'rm[[:space:]]+-rf[[:space:]]'         # rm -rf <anything>
  'chmod[[:space:]]+-R'
  'chown[[:space:]]+-R'
  ':\(\)\{.*\};:'                        # fork bomb
  'mkfs'
  'dd[[:space:]]+if='
  '>[[:space:]]*/dev/sd'
  'curl[[:space:]].*\|[[:space:]]*(sh|bash)'
  'wget[[:space:]].*\|[[:space:]]*(sh|bash)'
  'git[[:space:]]+push[[:space:]].*--force'
  'git[[:space:]]+push[[:space:]].*-f([[:space:]]|$)'
  'git[[:space:]]+reset[[:space:]]+--hard'
  'sudo[[:space:]]'
)

for pat in "${deny[@]}"; do
  if printf '%s' "$cmd" | grep -Eq "$pat"; then
    echo "blocked by .claude/hooks/block-destructive.sh: command matches destructive pattern /$pat/" >&2
    echo "If this is intentional, run it yourself outside the agent, or remove the pattern from the hook." >&2
    exit 2
  fi
done

exit 0
